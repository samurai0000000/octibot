# ==============================================================================
# OCTIBOT - Reference Bot Configuration
# Copyright (C) 2026, Charles Chiou
# ==============================================================================

# Global Server & Connection Defaults
server_host = 127.0.0.1
server_port = 8080
server_use_ssl = false

# Table & Match Policy
table_behavior = auto            # Options: auto, join_only, host_only, matchmaking, idle
accept_modes = 2P, 4P, OFK
accept_bases = any               # any, 1, 3
accept_super_prongs = any        # any, true, false
accept_edgeless = any            # any, true, false
accept_time_control = any        # any, timed_only, untimed_only
accept_takeback = any
min_initial_time_sec = 0
max_initial_time_sec = 14400
min_increment_sec = 0

# Social & Opponent Policies
# friend_list = alice, bob
# ban_list = troll1, griefer2
friends_only = false
opponent_filter = any            # any, humans_only, robots_only, owner_only

# Proposal & Rematch Defaults
accept_draw_eval_threshold = -1500
accept_undo = friends_only       # always, friends_only, never
accept_pause = always            # always, friends_only, never
accept_rematch = always          # always, friends_only, never
max_consecutive_rematches = 5
claim_forfeit_delay_sec = 10
min_move_think_ms = 0

# Telemetry
publish_move_telemetry = false   # Set to true to publish depth/nodes/score in move history
allow_public_eval_chat = true

# Proactive AI Commentary, Thinking Mumblings & Hourly Rate Caps
ai_proactive_commentary = true
ai_commentary_eval_swing_threshold = 2500
ai_commentary_cooldown_plies = 8
ai_think_mumbling = true         # Emit creative in-character thinking mumblings during >=20s adaptive searches
mumble_interval_ms = 20000       # In-flight mumbling cadence (20s, 40s); post-move remark on 60s max ceiling
mumble_ceiling_margin_ms = 2000  # Suppress in-flight milestone within margin of max ceiling (0 = no buffer)
max_mumbles_per_game = 10        # Per-game mumble cap across in-flight + post-move mumbles (0 = unlimited)
max_eval_swing_comments_per_game = 4 # Per-game eval_swing comment cap (0 = unlimited)
max_proactive_calls_per_hour = 60    # Rolling hourly proactive LLM call cap (0 = unlimited)
proactive_anchor_reserve_pct = 15    # Percentage [0..50] of hourly proactive budget reserved for game_start/game_over/goodbye
max_chat_replies_per_hour = 120      # Rolling hourly untrusted non-owner chat reply cap (0 = unlimited; owner exempt)
proactive_rate_window_seconds = 3600 # Rolling rate-limiter window duration in seconds

# Aimon MCP Gateway Bridge
aimon_enabled = true
aimon_host = 127.0.0.1
aimon_port = 3883
aimon_gateway_port = 3885
expose_mcp_tools = true
default_profile = stock

# Optional Managed Agent CLI Supervisor (disabled by default)
# ai_cli_backend = none          # none, agy, claude, cursor-agent
# ai_cli_executable = agy
# ai_cli_model = Gemini 3.8 Flash (Low)
# ai_cli_interactive = false
# ai_cli_persistent_table_session = true  # Table-scoped persistent agy stream-json process (0 MiB idle; pre-warmed on human join/observe)
# ai_cli_delta_prompts = true             # Omit repeated bootstrap/legend blocks on Turn 2+ while preserving <UNTRUSTED_NETWORK_DATA>
# ai_cli_session_max_turns = 120          # Rotate persistent table session after N turns
# ai_cli_session_startup_timeout_ms = 15000
# ai_cli_turn_timeout_ms = 45000
# ai_cli_mumble_timeout_ms = 15000
# ai_cli_session_eof_timeout_ms = 2000
# ai_cli_session_term_timeout_ms = 1000
# ai_cli_session_respawn_backoff_min_ms = 1000
# ai_cli_session_respawn_backoff_max_ms = 30000
# ai_cli_session_stderr_ring_bytes = 16384

# Optional Variant-Specific & Tactical Search Tuning Defaults (inherited by all slim [profiles])
# Define shared search/evaluation/variant weights once at global scope so multi-bot
# [profile] sections stay slim and only override identity, port, or hosted variant:
# composite_tactical_only_min_ply = 0
# qsearch_include_base_threat_prongs = false
# fix_stack_and_home_eval_mirage = false
# empty_allied_base_penalty_1b = 0
# empty_allied_base_1b_close_urgency_pct = 175
# empty_allied_base_1b_mid_urgency_pct = 130
# ofk_prong_seizure_weight = 450
# ofk_single_pod_monopoly_penalty = -1
# ofk_pod_val_scale_pct = 135
# ofk_captured_pod_penalty = 4800
# ofk_reserve_free_prong_val = 180
# four_player_eliminated_penalty = 20000
# four_player_wipeout_danger_pct = 50
# reserve_free_super_prong_val = 150
# non_edgeless_back_rank_penalty_2p = 850
# move_order_back_rank_retreat_penalty_2p = 3500
# multi_base_two_needed_threat_scale_pct = 35
# multi_base_three_needed_threat_scale_pct = 20
# multi_base_two_needed_scale_floor_pct = 60
# multi_base_three_needed_scale_floor_pct = 35

# ==============================================================================
# Robot Profiles
# ==============================================================================

# Default stock profile
[stock]
robot_name = stock
algorithm = alpha_beta
time_budget_ms = 1500
max_search_depth = 6
lazy_smp_threads = 2

# Fast blitz profile
[bot_fast]
robot_name = bot_fast
algorithm = alpha_beta
time_budget_ms = 500
max_search_depth = 4
lazy_smp_threads = 1

# Deep tactical search profile
[bot_deep]
robot_name = bot_deep
algorithm = alpha_beta
time_budget_ms = 4000
max_search_depth = 8
lazy_smp_threads = 4
captured_enemy_base_bonus = 32000
two_ply_base_threat_weight = 3000
