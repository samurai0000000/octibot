# ==============================================================================
# OCTIBOT - Starter & Reference Bot Configuration
# Copyright (C) 2026, Charles Chiou
# ==============================================================================

# Global Server & Connection Defaults
server_host = 127.0.0.1
server_port = 8080
server_use_ssl = false
allow_supersede = false          # Set to true (or pass --supersede) to kick an active bot session using the same token
default_profile = stock
verbosity = verbose              # verbose (3), info (2), error (1), quiet (0)

# Table & Match Policy
table_behavior = auto            # Options: auto, join_only, host_only, matchmaking, idle
accept_modes = 2P, 4P, OFK
accept_bases = any               # any, 1, 3
accept_super_prongs = any        # any, true, false
accept_edgeless = any            # any, true, false
accept_time_control = any        # any, timed_only, untimed_only
accept_takeback = any
min_initial_time_sec = 0
max_initial_time_sec = 14400
min_increment_sec = 0
# host_mode = 2P
# host_bases = 3
# host_super_prongs = false
# host_edgeless = false
# host_time_control_enabled = false
# host_initial_ms = 600000
# host_increment_ms = 5000
# host_allow_robots = true
# host_seat = wait_for_human     # wait_for_human (0), 1..4, a..d, or random
# host_variants = 2P_3B, 2P_3B_SP, 2P_3B_ED, 2P_3B_SPED, 2P_1B, 2P_1B_SP, 2P_1B_ED, 2P_1B_SPED, 4P, 4P_SP, 4P_ED, 4P_SPED, OFK

# Social & Opponent Policies
# friend_list = alice, bob
# ban_list = troll1, griefer2
friends_only = false
opponent_filter = any            # any, humans_only, robots_only, owner_only

# Timed Clock Pacing & Safety Margins (used when time_control.enabled = true;
# untimed club games always use each profile's time_budget_ms unchanged)
timed_auto_pace = true           # Scale move budgets from clock bank + increment up to timed_time_budget_max_ms
timed_time_budget_min_ms = 250
timed_time_budget_max_ms = 60000
clock_safety_margin_ms = 1500    # Hard sudden-death reserve kept on clock to prevent network/teardown flags
# timed_opening_taper_max_ply = 6
# timed_opening_taper_pct = 75
# timed_midgame_horizon_moves = 24
# timed_endgame_horizon_moves = 16
# timed_endgame_min_ply = 40
# timed_increment_weight_pct = 75
# timed_max_bank_fraction_pct = 40
# timed_emergency_floor_ms = 200

# Tournament Lifecycle Policies
accept_tournament_matches = true        # Exempt TD-paired tournament rooms from casual humans_only/friends_only/clock filters
tournament_post_game_linger_sec = 2     # Leave finished tournament rooms promptly so next Swiss/bracket round can start
tournament_suppress_casual_chat = true  # Suppress casual untimed greetings/goodbye chatter inside tournament rooms

# Proposal & Rematch Defaults
accept_draw_eval_threshold = -1500
accept_undo = friends_only       # always, friends_only, never
accept_pause = always            # always, friends_only, never
accept_rematch = always          # always, friends_only, never
max_consecutive_rematches = 5
claim_forfeit_delay_sec = 10
min_move_think_ms = 0

# Telemetry & Search Chat Announcements
publish_move_telemetry = false   # Set to true to publish depth/nodes/score in move history
announce_move_search_chat = true # Announce search depth/nodes/score/elapsed in room chat after each move

# Post-Game Linger & Goodbye
post_game_linger_sec = 60
chat_goodbye = Thanks for the game! Since things are quiet here, I'll head back to the lobby to host a new table—see you next time!

# Optional Variant-Specific & Tactical Search Tuning Defaults (inherited by all slim [profiles])
# Define shared search/evaluation/variant weights once at global scope so multi-bot
# [profile] sections stay slim and only override identity or hosted variant:
# composite_tactical_only_min_ply = 0
# qsearch_include_base_threat_prongs = false
# fix_stack_and_home_eval_mirage = false
# fix_4p_coalition_eval = true
# empty_allied_base_penalty_1b = 0
# empty_allied_base_1b_close_urgency_pct = 175
# empty_allied_base_1b_mid_urgency_pct = 130
# ofk_prong_seizure_weight = 450
# ofk_single_pod_monopoly_penalty = -1
# ofk_pod_val_scale_pct = 135
# ofk_captured_pod_penalty = 4800
# ofk_reserve_free_prong_val = 180
# four_player_eliminated_penalty = 20000
# four_player_wipeout_danger_pct = 50
# reserve_free_super_prong_val = 150
# non_edgeless_back_rank_penalty_2p = 850
# move_order_back_rank_retreat_penalty_2p = 3500
# multi_base_two_needed_threat_scale_pct = 35
# multi_base_three_needed_threat_scale_pct = 20
# multi_base_two_needed_scale_floor_pct = 60
# multi_base_three_needed_scale_floor_pct = 35

# ==============================================================================
# Robot Profiles
# ==============================================================================

# Default stock profile
[stock]
robot_name = stock
algorithm = alpha_beta
time_budget_ms = 1500
max_search_depth = 6
lazy_smp_threads = 2

# Fast blitz profile
[bot_fast]
robot_name = bot_fast
algorithm = alpha_beta
time_budget_ms = 500
max_search_depth = 4
lazy_smp_threads = 1

# Deep tactical search profile
[bot_deep]
robot_name = bot_deep
algorithm = alpha_beta
time_budget_ms = 4000
max_search_depth = 8
lazy_smp_threads = 4
captured_enemy_base_bonus = 32000
two_ply_base_threat_weight = 3000
