# ==============================================================================
# OCTIBOT - Reference Bot Configuration
# Copyright (C) 2026, Charles Chiou
# ==============================================================================

# Global Server & Connection Defaults
server_host = 127.0.0.1
server_port = 8080
server_use_ssl = false

# Table & Match Policy
table_behavior = auto            # Options: auto, join_only, host_only, matchmaking, idle
accept_modes = 2P, 4P, OFK
accept_bases = any               # any, 1, 3
accept_super_prongs = any        # any, true, false
accept_edgeless = any            # any, true, false
accept_time_control = any        # any, timed_only, untimed_only
accept_takeback = any
min_initial_time_sec = 0
max_initial_time_sec = 14400
min_increment_sec = 0

# Social & Opponent Policies
# friend_list = alice, bob
# ban_list = troll1, griefer2
friends_only = false
opponent_filter = any            # any, humans_only, robots_only, owner_only

# Proposal & Rematch Defaults
accept_draw_eval_threshold = -1500
accept_undo = friends_only       # always, friends_only, never
accept_pause = always            # always, friends_only, never
accept_rematch = always          # always, friends_only, never
max_consecutive_rematches = 5
claim_forfeit_delay_sec = 10
min_move_think_ms = 0

# Telemetry
publish_move_telemetry = false   # Set to true to publish depth/nodes/score in move history
allow_public_eval_chat = true

# Post-Game Linger & Goodbye
post_game_linger_sec = 60
chat_goodbye = Thanks for the game! Since things are quiet here, I'll head back to the lobby to host a new table—see you next time!

# Proactive AI Commentary
ai_proactive_commentary = true
ai_commentary_eval_swing_threshold = 2500
ai_commentary_cooldown_plies = 8

# Aimon MCP Gateway Bridge
aimon_enabled = true
aimon_host = 127.0.0.1
aimon_port = 3883
aimon_gateway_port = 3885
expose_mcp_tools = true
default_profile = stock

# Optional Managed Agent CLI Supervisor (disabled by default)
# ai_cli_backend = none          # none, agy, claude, cursor-agent
# ai_cli_executable = agy
# ai_cli_model = flash
# ai_cli_interactive = false
# ai_personality = You are @octibot-sdk-cpu, a mellow, friendly, and thoughtful OCTI club player created by @samurai (Charles Chiou). You speak in a relaxed, warm, down-to-earth tone—never boastful, theatrical, or condescending. Enjoy chatting casually about the moves on the board in 1-2 short, natural sentences.

# ==============================================================================
# Robot Profiles
# ==============================================================================

# Default stock profile
[stock]
robot_name = stock
algorithm = alpha_beta
time_budget_ms = 1500
max_search_depth = 6
lazy_smp_threads = 2

# Fast blitz profile
[bot_fast]
robot_name = bot_fast
algorithm = alpha_beta
time_budget_ms = 500
max_search_depth = 4
lazy_smp_threads = 1

# Deep tactical search profile
[bot_deep]
robot_name = bot_deep
algorithm = alpha_beta
time_budget_ms = 4000
max_search_depth = 8
lazy_smp_threads = 4
captured_enemy_base_bonus = 32000
two_ply_base_threat_weight = 3000

# NNUE-evaluated Alpha-Beta search profile
[bot_nnue]
robot_name = bot_nnue
algorithm = nnue
time_budget_ms = 1500
search_depth = 4
search_threads = 2
hw_backend = cpu                 # cpu (CPU_SIMD AVX2/FMA), ort (ORT_GPU_TPU), cavalry (CAVALRY_NVP)
# model_path = /path/to/model.onnx
nn_blend_weight = 0.75           # 0.0 = tactical only, 1.0 = neural net only
use_opening_book = true

# Transformer-evaluated Batched MCTS profile
[bot_transformer]
robot_name = bot_transformer
algorithm = transformer_mcts
time_budget_ms = 1500
search_threads = 2
mcts_simulations = 256
mcts_batch_size = 16
mcts_cpuct = 1.5
hw_backend = cpu                 # cpu, ort, cavalry
# model_path = /path/to/model.onnx
nn_blend_weight = 0.75
use_opening_book = true

# ResNet-evaluated Batched MCTS profile
[bot_resnet]
robot_name = bot_resnet
algorithm = resnet_mcts
time_budget_ms = 1500
search_threads = 2
mcts_simulations = 256
mcts_batch_size = 16
mcts_cpuct = 1.5
hw_backend = cpu                 # cpu, ort, cavalry
# model_path = /path/to/model.onnx
nn_blend_weight = 0.75
use_opening_book = true

# Lobby concierge & technical Q&A assistant profile
[octibot-helper]
# Non-playing lobby concierge, technical Q&A & matchmaking assistant
handle = octibot-helper
algorithm = helper
lobby_only = true
table_behavior = lobby_only
web_bind = 0.0.0.0
web_port = 3891
aimon_enabled = true
expose_mcp_tools = true
ai_cli_backend = agy
ai_cli_executable = agy
ai_cli_model = gemini-3-flash-preview
ai_personality = friendly, knowledgeable OCTI lobby concierge and technical guide
greeting_lobby = Hello! I am @octibot-helper, the OCTI lobby concierge. Ask me anything about OCTI rules, octi.selfso.com tables, how our bots work, report bugs/feature ideas, or ask me to set up a match with any of our playing bots!
max_chat_reply_chunks = 3
helper_repo_access = true
helper_octi_dir = ~/work/octi
helper_octibot_dir = ~/work/octibot
helper_octibot_cc_dir = ~/work/octibot_cc
helper_feedback_enabled = true
helper_feedback_file = ~/work/octi/plan/player_feedback.md

